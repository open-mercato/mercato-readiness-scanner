{
  "name": "mercato-readiness-scanner",
  "version": "0.1.0",
  "description": "Static production-readiness scanner for Open Mercato applications.",
  "type": "module",
  "bin": {
    "mercato-readiness-scanner": "dist/cli.js",
    "mercato-readiness": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:built": "node --test test-built/*.test.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:built && npm run pack:check && npm run registry:check",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-mercato/mercato-readiness-scanner.git"
  },
  "homepage": "https://github.com/open-mercato/mercato-readiness-scanner#readme",
  "bugs": {
    "url": "https://github.com/open-mercato/mercato-readiness-scanner/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
